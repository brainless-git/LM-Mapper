# LogicMonitor portal: <company>.logicmonitor.com
LM_COMPANY=quorum

# Auth: use EITHER a Bearer token OR an LMv1 access ID/key (read-only role recommended)
LM_BEARER_TOKEN=
LM_ACCESS_ID=
LM_ACCESS_KEY=

# Optional: limit which LM devices are indexed (LM REST filter syntax)
# LM_DEVICE_FILTER=displayName~"-sw"

# Ordered regex list. First pattern that matches a DataSource on the device is used.
# LM_INTERFACE_DATASOURCES=^SNMP_Network_Interfaces$,^snmp64_If-?$,Interfaces,FortiSwitch.*Port

# Datapoint names tried (in order) for interface operational status
# LM_STATUS_DATAPOINTS=OperStatus,Status,ifOperStatus

# Instance properties used for interface name matching and the LM-side description
# LM_NAME_PROPERTIES=auto.interface.name,auto.interface.description,auto.interface.ifname
# LM_ALIAS_PROPERTIES=auto.interface.alias,auto.interface.ifalias

# Per-instance status lookups cost 1 API call per port. Disable for very large estates.
LM_FETCH_STATUS=true
LM_FETCH_ALERTS=true
LM_MAX_WORKERS=6

# 0 = refresh only on startup and when the Refresh button / POST /api/refresh is used
REFRESH_INTERVAL_MINUTES=0

# Optional HTTP basic auth for the UI and API
UI_USERNAME=
UI_PASSWORD=

LOG_LEVEL=INFO
